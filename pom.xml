<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <dependencyManagement>
        <dependencies>
            <!-- Boot 4.1.1 的 BOM 只带 jackson 3.1.5，低于修复门槛 3.1.7
                 （CVE-2026-91776），故显式 import 修复版 -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>3.1.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>






    <groupId>com.example</groupId>
    <artifactId>spring-vault-job-demo</artifactId>
    <version>0.1.0</version>
    <name>spring-vault-job-demo</name>
    <description>Minimal Spring Boot batch job that fetches dynamic DB credentials from HashiCorp Vault</description>

    <properties>
        <java.version>21</java.version>
        <spring-vault.version>4.1.1</spring-vault.version>
        <!-- Boot 4.x 的 BOM 不再管理 spring-retry（模块化 starter 重组），需显式指定版本 -->
        <spring-retry.version>2.0.13</spring-retry.version>
    </properties>

    <dependencies>
        <!-- Web is intentionally NOT included: this is a CLI/Job app, not a server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- JDBC + HikariCP for DataSource -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Spring Vault: VaultTemplate + AppRole auth (NOT spring-cloud-starter-vault-config) -->
        <dependency>
            <groupId>org.springframework.vault</groupId>
            <artifactId>spring-vault-core</artifactId>
            <version>${spring-vault.version}</version>
        </dependency>

        <!-- Spring Retry: pattern B retry-on-auth-failure wrapper for the long-job runner -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
                <version>${spring-retry.version}</version>
        </dependency>

        <!-- Actuator: exposes /actuator/health and friends; HealthIndicator SPI -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Boot 4.0 的模块化 starter 重组：Jackson 已从默认 spring-boot-starter 中移除。
             本项目用 RestTemplate 读 Vault 的 application/json 响应（sys/wrapping/unwrap），
             没有 JSON 消息转换器会抛 UnknownContentTypeException。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <!-- Prometheus scrape endpoint via Micrometer -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Database driver: PostgreSQL example. Swap to mysql-connector-j if needed. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>